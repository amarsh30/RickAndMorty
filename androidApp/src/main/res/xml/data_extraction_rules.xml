<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-to-device transfer rules for Android 12 (API 31) and higher.

    Only the Room database is kept, because it holds the user's favorites. Favorites and the
    offline cache share this one file, so the cache travels with it. Once an <include> is
    present, nothing else is backed up: not the image cache, profile installer files,
    or any file added later.

    The -wal file is included because SQLite keeps recent writes (including new favorites)
    there until a checkpoint; the main file alone could be missing them. The -shm index and
    the .lck lock file are rebuilt by SQLite and are left out.

    Keep the file name in sync with DatabaseBuilder.android.kt ("rick_and_morty.db").
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="rick_and_morty.db" />
        <include domain="database" path="rick_and_morty.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="rick_and_morty.db" />
        <include domain="database" path="rick_and_morty.db-wal" />
    </device-transfer>
</data-extraction-rules>
